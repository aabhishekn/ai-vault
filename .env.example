POSTGRES_DB=ai_vault
POSTGRES_USER=ai_vault
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
REDIS_URL=redis://127.0.0.1:6379/0

# Needed only when enabling real AI requests
OPENAI_API_KEY=
# Embeddings run automatically when OPENAI_API_KEY is set (chunk text is sent to OpenAI).
# Uncomment to force them on or off regardless of the key.
# ENABLE_EMBEDDINGS=false
# A summary and key insights are generated after embedding; follows ENABLE_EMBEDDINGS unless set.
# AUTO_GENERATE_CONTENT=false
ANSWER_MODEL=gpt-4.1-mini

# Operations (all optional; defaults shown)
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
# Per client IP. 0 disables a rule.
AI_RATE_LIMIT_PER_MINUTE=20
AI_DAILY_QUOTA=500
UPLOAD_RATE_LIMIT_PER_MINUTE=10
